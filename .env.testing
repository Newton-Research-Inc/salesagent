# Testing Configuration - No Authentication Required

# Enable test mode (bypasses authentication)
ADCP_TESTING=true

# Set default test tenant and principal for each service
# When ADCP_TESTING=true, these will be used instead of token auth

# For ESPN testing
ADCP_TEST_TENANT_ID=espn
ADCP_TEST_PRINCIPAL_ID=nike

# Ports (same as before)
POSTGRES_PORT=9532
ADCP_SALES_PORT=9580
A2A_PORT=9591
ADMIN_UI_PORT=9501
CREATE_SAMPLE_DATA=true
